# {{ ansible_managed }}
# athena-runner.service — Athena ephemeral GitHub Actions self-hosted runner
# (Plan 06, Task 1; CONTEXT.md D-16/D-17, RESEARCH.md Pattern 4).
#
# One pristine runner per job: `--jitconfig` implies `--ephemeral`, so
# GitHub deregisters this runner the moment it finishes exactly one job and
# run.sh exits. Restart=always with a short RestartSec then produces the
# restart loop — ExecStartPre wipes any stale _work directory and fetches a
# brand-new single-use JIT configuration, ExecStart registers+runs against
# it, and the cycle repeats. No reusable registration credential is ever
# held by this unit: the PAT lives in a root-readable file outside every
# estate repository ({{ athena_runner_pat_file }}) and only jitconfig.sh
# reads it, at runtime, per start.
[Unit]
Description=Athena ephemeral GitHub Actions self-hosted runner (org-registered, JIT config per start)
Documentation=https://docs.github.com/actions/hosting-your-own-runners
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ athena_runner_user }}
Group={{ athena_runner_user }}
WorkingDirectory={{ athena_runner_home }}

# Live finding, this plan: the runner binary's own --jitconfig startup path
# writes .credentials, .credentials_rsaparams (an RSA private key used to
# sign the runner's session token requests), and .runner into its home
# directory at the OS's default umask (022 -> world-readable, 0644) — this
# is GitHub's own runner software, not something this role's tasks create,
# so it cannot be fixed by an Ansible file/template task. UMask=0077 forces
# every file this service process creates (these three, and anything
# written under _work) to 0600 from the first write, closing that gap
# without needing a post-hoc chmod race.
UMask=0077

# RuntimeDirectory lives at /run/athena-runner and is created fresh
# (and wiped) by systemd on every unit start/stop — this is where the
# single-use JIT config lands, so it never outlives the job it was fetched
# for (T-01-32: cross-job filesystem contamination mitigation).
RuntimeDirectory=athena-runner
RuntimeDirectoryMode=0700

# Belt-and-braces pristine-per-job guarantee beyond what RuntimeDirectory
# alone covers: also clear any leftover _work contents from a previous job
# before the next one starts.
ExecStartPre=/usr/bin/rm -rf {{ athena_runner_home }}/{{ athena_runner_work_folder }}
ExecStartPre={{ athena_runner_home }}/jitconfig.sh
ExecStart=/usr/bin/bash -c '"{{ athena_runner_home }}/run.sh" --jitconfig "$(cat ${RUNTIME_DIRECTORY}/jitconfig.json)"'

Restart=always
RestartSec=5

# Non-secret environment only — the PAT and the fetched JIT config both
# live in files (root-readable-only-until-group-tightened PAT; mode-0600
# RuntimeDirectory JIT config), never as unit Environment= values. A
# systemd unit file is world-readable on disk and its Environment= values
# appear in `systemctl show`/journal context — exactly the leak this design
# avoids (RESEARCH.md Security Domain, T-01-29).
Environment=DOTNET_NOLOGO=1
Environment=HOME={{ athena_runner_home }}

[Install]
WantedBy=multi-user.target
